# Local Hugging Face training.
# The default public model does not require HF_TOKEN.
# Only set HF_TOKEN if you switch to a gated/private model later.

# Optional override for the default local trainable model.
# The code defaults to HuggingFaceTB/SmolLM2-1.7B-Instruct.
HF_TRAIN_MODEL=HuggingFaceTB/SmolLM2-1.7B-Instruct

# Optional local cache directory for downloaded Hugging Face artifacts.
HF_CACHE_DIR=.cache/huggingface

# Modal authentication for remote training runs.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# OpenRouter-backed opponent pool / live integration tests.
# Training now expects the opponent pool to come from train.yaml and uses OPENROUTER_API_KEY for those calls.
OPENROUTER_API_KEY=
RUN_OPENROUTER_LIVE_TESTS=0

# ElevenLabs TTS (remote API — synthesis is on ElevenLabs; this machine only plays audio).
# Used by `scripts/play_openrouter_game.py --tts`, `scripts/train_local.py --tts`, or train.yaml viewer.tts_enabled.
ELEVENLABS_API_KEY=
# Comma-separated voice ids for player speech. If you provide fewer than the player count,
# the runner cycles through them. Example: voice_id_1,voice_id_2,voice_id_3
ELEVENLABS_PLAYER_VOICE_IDS=tnSpp4vdxKPjI9w0GnoV,RILOU7YmBhvwJGDGjNmP,UgBBYS2sOqTuMpoF3BR0,Z3R5wn05IrDiVCyEkUrK,aMSt68OGf4xUZAnLpTU8,EkK5I93UQWFDigLMpZcX
# Optional narrator voice id for phase changes, eliminations, and other non-player narration.
ELEVENLABS_NARRATOR_VOICE_ID=BIvP0GN1cAtSRTxNHnWS
# Optional ElevenLabs hosted TTS model id and audio output format.
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
# Optional override for the local playback executable. On macOS, `afplay` usually works out of the box.
ELEVENLABS_AUDIO_PLAYER=
