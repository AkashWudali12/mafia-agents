# Local Hugging Face training.
# The default public model does not require HF_TOKEN.
# Only set HF_TOKEN if you switch to a gated/private model later.

# Optional override for the default local trainable model.
# The code defaults to HuggingFaceTB/SmolLM2-1.7B-Instruct.
HF_TRAIN_MODEL=HuggingFaceTB/SmolLM2-1.7B-Instruct

# Optional local cache directory for downloaded Hugging Face artifacts.
HF_CACHE_DIR=.cache/huggingface

# Modal authentication for remote training runs.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# OpenRouter-backed opponent pool / live integration tests.
# Training now expects the opponent pool to come from train.yaml and uses OPENROUTER_API_KEY for those calls.
OPENROUTER_API_KEY=
RUN_OPENROUTER_LIVE_TESTS=0
